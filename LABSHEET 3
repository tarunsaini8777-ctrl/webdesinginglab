<!DOCTYPE html>
<html>

<head>
    <title>Fibonacci Series</title>
</head>

<body>

    <input type="number" id="n" placeholder="Enter terms">
    <button onclick="fibonacci()">Generate</button>

    <p id="result"></p>

    <script>
        function fibonacci() {
            let n = Number(document.getElementById("n").value);
            let a = 0, b = 1;
            let output = "";

            for (let i = 1; i <= n; i++) {
                output += a + " ";
                let next = a + b;
                a = b;
                b = next;
            }

            document.getElementById("result").innerHTML = output;
        }
    </script>

</body>

</html>

