<!DOCTYPE html>
<html>

<head>
    <title>Prime Check</title>
</head>

<body>

    <input type="number" id="num" placeholder="Enter number">
    <button onclick="checkPrime()">Check</button>

    <div id="result"></div>

    <script>
        function checkPrime() {
            let n = Number(document.getElementById("num").value);
            let prime = true;

            if (n <= 1) {
                prime = false;
            }

            for (let i = 2; i < n; i++) {
                if (n % i === 0) {
                    prime = false;
                    break;
                }
            }

            if (prime) {
                document.getElementById("result").innerHTML = n + " is Prime";
            } else {
                document.getElementById("result").innerHTML = n + " is Composite";
            }
        }
    </script>

</body>

</html>
